<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<CheckEolTargetFramework>false</CheckEolTargetFramework>
		<Version>1.2.0</Version>
		<Authors>leandrobueno</Authors>
		<GameDir>C:\Program Files (x86)\Steam\steamapps\common\Castlevania Belmont's Curse</GameDir>
	</PropertyGroup>
	<ItemGroup>
		<Reference Include="$(GameDir)\BepInEx\core\BepInEx.Core.dll" Private="false" />
		<Reference Include="$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
		<Reference Include="$(GameDir)\BepInEx\core\0Harmony.dll" Private="false" />
		<Reference Include="$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll" Private="false" />
		<Reference Include="$(GameDir)\BepInEx\interop\Il2Cppmscorlib.dll" Private="false" />
		<Reference Include="$(GameDir)\BepInEx\interop\Il2CppSystem.dll" Private="false" />
		<Reference Include="$(GameDir)\BepInEx\interop\Il2CppSystem.Core.dll" Private="false" />
		<Reference Include="$(GameDir)\BepInEx\interop\UnityEngine.CoreModule.dll" Private="false" />
		<Reference Include="$(GameDir)\BepInEx\interop\UnityEngine.TextRenderingModule.dll" Private="false" />
		<Reference Include="$(GameDir)\BepInEx\interop\UnityEngine.UI.dll" Private="false" />
		<Reference Include="$(GameDir)\BepInEx\interop\UnityEngine.UIModule.dll" Private="false" />
		<Reference Include="$(GameDir)\BepInEx\interop\Unity.TextMeshPro.dll" Private="false" />
		<Reference Include="$(GameDir)\BepInEx\interop\Unity.Addressables.dll" Private="false" />
		<Reference Include="$(GameDir)\BepInEx\interop\Unity.ResourceManager.dll" Private="false" />
		<Reference Include="$(GameDir)\BepInEx\interop\Unity.InputSystem.dll" Private="false" />
		<Reference Include="$(GameDir)\BepInEx\interop\Assembly-CSharp.dll" Private="false" />
		<Reference Include="$(GameDir)\BepInEx\interop\MotherBase.EntityFramework.dll" Private="false" />
		<Reference Include="$(GameDir)\BepInEx\interop\MotherBase.ActionFramework.dll" Private="false" />
		<Reference Include="$(GameDir)\BepInEx\interop\MotherBase.ToolKit.dll" Private="false" />
		<Reference Include="$(GameDir)\BepInEx\interop\MotherBase.FeedbackManager.dll" Private="false" />
		<!-- Optional at run time (soft dependency): the settings panel and the Minimap MODS page. Build BelmontUI first. -->
		<Reference Include="$(GameDir)\BepInEx\plugins\BelmontUI\BelmontUI.dll" Private="false" />
	</ItemGroup>
	<!-- dotnet build -p:CopyToGame=false builds without touching the game (it locks the dll while running). -->
	<Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(CopyToGame)' != 'false'">
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\AbilityWheel" />
	</Target>

</Project>
